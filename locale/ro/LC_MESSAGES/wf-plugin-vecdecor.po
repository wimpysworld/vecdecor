#. (itstool) path: plugin/_short
msgid "Vecdecor"
msgstr "Vecdecor"

#. (itstool) path: plugin/_long
msgid "A highly configurable and optionally fancy decorator plugin for Wayfire."
msgstr "Un decorator foarte configurabil și opțional extravagant pentru wayfire."

#. (itstool) path: group/_short
msgid "General"
msgstr "Generale"

#. (itstool) path: option/_short
msgid "Border size"
msgstr "Dimensiunea bordurii"

#. (itstool) path: option/_long
msgid "Sets the border size in pixels."
msgstr "Stabilește dimensiunea bordurii în pixeli."

#. (itstool) path: option/_short
msgid "When to render the titlebar"
msgstr "Când să se deseneze bara de titlu"

#. (itstool) path: option/_long
msgid "When to render a titlebar with title text and buttons."
msgstr "Când să se deseneze o bară de titlu cu textul titlului și butoanele."

#. (itstool) path: desc/_name
msgid "Always"
msgstr "Întotdeauna"

#. (itstool) path: desc/_name
msgid "Only When Windowed"
msgstr "Doar când este nemaximizată"

#. (itstool) path: desc/_name
msgid "Only When Maximized"
msgstr "Doar când este maximizată"

#. (itstool) path: desc/_name
msgid "Never"
msgstr "Niciodată"

#. (itstool) path: option/_short
msgid "Draw borders on maximized windows"
msgstr "Desenează borduri pe ferestrele maximizate"

#. (itstool) path: option/_long
msgid "Whether or not to render side and bottom decorations on maximized windows."
msgstr "Dacă să se deseneze decorațiile laterale și de jos pe ferestrele maximizate sau nu."

#. (itstool) path: option/_short
#: metadata/vecdecor.xml:42
msgid "Decoration disabled for specified window types"
msgstr "Decorarea dezactivată pentru tipurile specificate de ferestre"

#. (itstool) path: option/_long
msgid "Disables window decoration for windows matching the specified criteria."
msgstr "Dezactivează decorarea ferestrelor care îndeplinesc criteriile specificate."

#. (itstool) path: option/_short
msgid "Decoration applied for specified window types"
msgstr "Decorarea aplicată pentru tipurile specificate de ferestre"

#. (itstool) path: option/_long
msgid "Forces window decoration for windows matching the specified criteria."
msgstr "Forțează decorarea ferestrelor care îndeplinesc criteriile specificate."

#. (itstool) path: option/_short
msgid "Title Font"
msgstr "Fontul titlului"

#. (itstool) path: option/_long
msgid "Font to use for the titlebar. The font size determines the titlebar height."
msgstr "Fontul de folosit pentru bara de titlu. Dimensiunea fontului determină înălțimea barei de titlu."

#. (itstool) path: option/_short
msgid "Color when focused"
msgstr "Culoare când este focalizată"

#. (itstool) path: option/_long
msgid "Color of the window border when it has focus."
msgstr "Culoarea marginii ferestrei când aceasta deține focalizarea."

#. (itstool) path: option/_short
msgid "Color when not focused"
msgstr "Culoare când nu este focalizată"

#. (itstool) path: option/_long
msgid "Color of the window border when it does not have focus."
msgstr "Culoarea marginii ferestrei când aceasta nu deține focalizarea."

#. (itstool) path: option/_short
msgid "Text color when focused"
msgstr "Culoarea textului când este focalizată"

#. (itstool) path: option/_long
msgid "Color of the window titlebar text when it has focus."
msgstr "Culoarea textului titlului ferestrei când aceasta deține focalizarea."

#. (itstool) path: option/_short
msgid "Text color when not focused"
msgstr "Culoarea textului când nu este focalizată"

#. (itstool) path: option/_long
msgid "Color of the window titlebar text when it does not have focus."
msgstr "Culoarea textului titlului ferestrei când aceasta nu deține focalizarea."

#. (itstool) path: option/_short
msgid "Titlebar Text Alignment"
msgstr "Alinierea textului titlului"

#. (itstool) path: option/_long
msgid "Sets the alignment of the titlebar text."
msgstr "Stabilește alinierea textului barei de titlu."

#. (itstool) path: desc/_name
msgid "Left"
msgstr "Stânga"

#. (itstool) path: desc/_name
msgid "Center"
msgstr "Centru"

#. (itstool) path: desc/_name
msgid "Right"
msgstr "Dreapta"

#. (itstool) path: option/_short
#: metadata/vecdecor.xml:94
msgid "Rounded Corner Radius"
msgstr "Raza colțurilor rotunjite"

#. (itstool) path: option/_long
msgid "The radius for corners."
msgstr "Raza de folosit pentru colțuri."

#. (itstool) path: group/_short
msgid "Buttons"
msgstr "Butoane"

#. (itstool) path: option/_short
msgid "Button Layout"
msgstr "Aranjament butoane"

#. (itstool) path: option/_long
msgid "The layout of the 'minimize', 'maximize' and 'close' buttons. Use a comma to separate button strings and a colon to denote the seperation between left and right buttons."
msgstr "Aranjamentul butoanelor „minimize” (minimizare), „maximize” (maximizare) și „close” (închidere). Folosiți câte o virgulă pentru a separa numele butoanelor și două puncte (:) pentru a marca separarea dintre butoanele de pe stânga și cele de pe dreapta."

#. (itstool) path: option/_short
msgid "Button Colour"
msgstr "Culoarea butoanelor"

#. (itstool) path: option/_long
msgid "Colour of active buttons."
msgstr "Culoarea butoanelor de minimizare, maximizare și închidere."

#. (itstool) path: option/_short
msgid "Inactive Button Colour"
msgstr ""

#. (itstool) path: option/_long
msgid "Colour of inactive buttons."
msgstr ""

#. (itstool) path: option/_short
msgid "Hover Button Colour"
msgstr ""

#. (itstool) path: option/_long
msgid "Colour of buttons under the pointer."
msgstr ""

#. (itstool) path: option/_short
msgid "Pressed Button Colour"
msgstr ""

#. (itstool) path: option/_long
msgid "Colour of pressed buttons."
msgstr ""

#. (itstool) path: option/_short
msgid "Button Line Thickness"
msgstr "Grosimea liniei butoanelor"

#. (itstool) path: option/_long
msgid "The line thickness for procedural fallback controls. SVG controls define their own line thickness."
msgstr "Grosimea liniei pentru controalele de rezervă generate procedural. Controalele SVG își definesc propria grosime a liniei."

#. (itstool) path: option/_short
msgid "Left Button Spacing"
msgstr "Spațierea butoanelor din stânga"

#. (itstool) path: option/_long
msgid "The space between each button on the left."
msgstr "Spațiul adăugat între butoanele de pe stânga."

#. (itstool) path: option/_short
msgid "Right Button Spacing"
msgstr "Spațierea butoanelor din dreapta"

#. (itstool) path: option/_long
msgid "The space between each button on the right."
msgstr "Spațiul adăugat între butoanele de pe dreapta."

#. (itstool) path: option/_short
msgid "Left Button X Offset"
msgstr "Deviație pe X pentru butoanele din stânga"

#. (itstool) path: option/_long
msgid "Use this option to move the buttons on the left to the left or right."
msgstr "Folosiți această opțiune pentru a muta butoanele de pe stânga mai la stânga sau mai la dreapta."

#. (itstool) path: option/_short
msgid "Right Button X Offset"
msgstr "Deviație pe X pentru butoanele din dreapta"

#. (itstool) path: option/_long
msgid "Use this option to move the buttons on the right to the left or right."
msgstr "Folosiți această opțiune pentru a muta butoanele de pe dreapta mai la stânga sau mai la dreapta."

#. (itstool) path: option/_short
msgid "Button Y Offset"
msgstr "Poziția pe Y a butoanelor"

#. (itstool) path: option/_long
msgid "Use this option to move buttons up or down."
msgstr "Folosiți această opțiune pentru a muta butoanele mai sus sau mai jos."

#. (itstool) path: option/_short
msgid "Button Hover Animation Duration"
msgstr "Durata animației de planare pe butoane"

#. (itstool) path: option/_long
msgid "The time the hover animation will last, in milliseconds."
msgstr "Timpul în milisecunde pe care îl va dura animația când se planează pe butoane."

#. (itstool) path: option/_short
msgid "Minimise Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the minimise button."
msgstr ""

#. (itstool) path: option/_short
msgid "Maximise Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the maximise button."
msgstr ""

#. (itstool) path: option/_short
msgid "Restore Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the restore button."
msgstr ""

#. (itstool) path: option/_short
msgid "Close Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the close button."
msgstr ""

#. (itstool) path: group/_short
msgid "Shade"
msgstr "Restrângere"

#. (itstool) path: option/_short
msgid "Enable Shade Effect"
msgstr "Activează efectul de restrângere"

#. (itstool) path: option/_long
msgid "Use the axis binding or scroll on the titlebar of Vecdecor windows to shade windows into their respective titlebars."
msgstr "Folosiți asocierea de axă sau derulați pe bara de titlu a ferestrelor decorate de Vecdecor pentru a le restrânge în barele de titlu respective."

#. (itstool) path: option/_short
msgid "Shade Duration"
msgstr "Durata restrângerii"

#. (itstool) path: option/_long
msgid "The duration of the shade animation in milliseconds."
msgstr "Durata animației de restrângere, în milisecunde."

#. (itstool) path: option/_short
msgid "Shade Modifier"
msgstr "Modificator de restrângere"

#. (itstool) path: option/_long
msgid "When the shade modifier key is held down, you can scroll down and up to shade and unshade the window."
msgstr "Când tasta modificator pentru restrângere este apăsată, puteți derula în jos și în sus pentru a restrânge fereastra sau a o readuce la starea inițială."

#. (itstool) path: option/_short
msgid "Toggle Window Shade"
msgstr "Comutare restrângere fereastră"

#. (itstool) path: option/_long
msgid "Toggles shade for the active window."
msgstr "Comută restrângerea ferestrei active."

#. (itstool) path: option/_short
msgid "CSD Titlebar Height"
msgstr "Înălțimea barei de titlu CSD"

#. (itstool) path: option/_long
msgid "Because there is no way to know the client surface titlebar height, this is an option to adjust it."
msgstr "Pentru că nu se poate ști dimensiunea barei de titlu furnizată de client, această opțiune o poate regla."

#. (itstool) path: option/_short
#: metadata/vecdecor.xml:21
msgid "Titlebar Height"
msgstr ""

#. (itstool) path: option/_long
#: metadata/vecdecor.xml:22
msgid "Sets the titlebar height in logical pixels. A value of 0 selects automatic sizing."
msgstr ""

#. (itstool) path: option/_short
#: metadata/vecdecor.xml:93
msgid "Button Size"
msgstr ""

#. (itstool) path: option/_long
#: metadata/vecdecor.xml:94
msgid "Sets the button size in logical pixels. A value of 0 selects automatic sizing."
msgstr ""
