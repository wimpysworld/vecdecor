msgid "Restore Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the restore button."
msgstr ""

#. (itstool) path: option/_short
msgid "Close Button SVG"
msgstr ""

#. (itstool) path: option/_long
msgid "The SVG file to use for the close button."
msgstr ""

